---
// Short centered gold rules with a small botanical glyph — the section divider.
interface Props {
  label?: string
}

const { label } = Astro.props
---

<div class="divider" role="separator" aria-label={label ?? undefined} aria-hidden={label ? undefined : 'true'}>
  <span class="divider-rule"></span>
  <span class="divider-glyph">❦</span>
  <span class="divider-rule"></span>
</div>
