---
import Base from '../layouts/Base.astro'
import Divider from '../components/Divider.astro'

const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=1513+at+Stone+Creek%2C+Rockmart%2C+GA'
---

<Base title="Travel" description="Venue, hotels, and driving notes for Kendra & Nando's wedding in Rockmart, Georgia.">
  <section class="page page-narrow">
    <header class="page-header">
      <h1 class="section-title" data-testid="travel-heading">Travel &amp; Stay</h1>
      <Divider />
      <p class="lede" data-testid="travel-lede">
        Everything you need to get here, park, and rest your dancing feet.
      </p>
    </header>

    <section class="travel-section" data-testid="travel-venue">
      <div class="venue-card frame">
        <h2 class="venue-name" data-testid="venue-name">1513 at Stone Creek</h2>
        <p data-testid="venue-address">Rockmart, Georgia</p>
        <a class="btn btn-outline" href={mapsUrl} target="_blank" rel="noopener noreferrer" data-testid="venue-map-link">
          Open in Google Maps
        </a>
      </div>
    </section>

    <!--
      ✏️ COUPLE: HOTELS — replace the placeholder cards below with real hotel
      blocks (name, distance, booking link). A room-block discount code works
      nicely in the card body. Delete this comment when done.
    -->
    <section class="travel-section" data-testid="travel-hotels">
      <h2 class="section-title" style="font-size:1.3rem;">Where to Stay</h2>
      <p class="center">
        Details coming soon — we're gathering hotel options in the Rockmart &amp; Cartersville area.
      </p>
      <div class="hotels-grid">
        <div class="hotel-card frame" data-testid="hotel-card-1">
          <h3 class="hotel-name">Hotel One</h3>
          <p>Rockmart area · details coming soon</p>
        </div>
        <div class="hotel-card frame" data-testid="hotel-card-2">
          <h3 class="hotel-name">Hotel Two</h3>
          <p>Cartersville area · details coming soon</p>
        </div>
      </div>
    </section>

    <!--
      ✏️ COUPLE: DRIVING NOTES — add directions from Atlanta, Rome, Cartersville,
      etc., plus parking instructions when the venue confirms them.
    -->
    <section class="travel-section" data-testid="travel-driving">
      <h2 class="section-title" style="font-size:1.3rem;">Driving Notes</h2>
      <div class="note-box frame" data-testid="driving-note">
        <p class="note-title">Parking &amp; Directions</p>
        <p>Details coming soon — check back for directions from your route and on-site parking guidance.</p>
      </div>
    </section>
  </section>
</Base>
