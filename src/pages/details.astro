---
import Base from '../layouts/Base.astro'
import Divider from '../components/Divider.astro'
---

<Base title="Wedding Details" description="The essentials for Kendra & Nando's wedding: adults-only celebration, attire, and more.">
  <section class="page page-narrow">
    <header class="page-header">
      <h1 class="section-title" data-testid="details-heading">Wedding Details</h1>
      <Divider />
      <p class="lede" data-testid="details-lede">The little things that make the day go round.</p>
    </header>

    <div class="callout" data-testid="adults-only-note">
      <p class="script callout-title">a grown-up celebration</p>
      <p>
        We love your little ones, but this will be an adults-only celebration. Thank you for
        understanding!
      </p>
    </div>

    <div class="note-box frame" data-testid="details-attire-note">
      <p class="note-title">Wedding Attire</p>
      <p>Details coming soon — check back for guidance on what to wear.</p>
    </div>

    <!--
      ✏️ COUPLE: ADD ANYTHING ELSE HERE — colors of the day, unplugged-ceremony
      note, plus-one policies, gifts for out-of-town guests… Duplicate the
      note-box block below for each new detail.
    -->
    <div class="note-box frame" data-testid="details-extra-1">
      <p class="note-title">More to Come</p>
      <p>We'll keep this page updated as the details come together — check back as the day draws near.</p>
    </div>
  </section>
</Base>
