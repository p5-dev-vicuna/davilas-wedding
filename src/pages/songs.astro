---
import Base from '../layouts/Base.astro'
import Divider from '../components/Divider.astro'
---

<Base title="Song Requests" description="Request a song for Kendra & Nando's reception — help us fill the dance floor.">
  <section class="page page-narrow">
    <header class="page-header">
      <h1 class="section-title" data-testid="songs-heading">Song Requests</h1>
      <Divider />
      <p class="lede" data-testid="songs-lede">
        The dance floor needs you — tell us what gets you moving.
      </p>
    </header>

    <form id="song-form" class="form" novalidate data-testid="song-form">
      <div class="field">
        <label for="song-title">Song title</label>
        <input
          id="song-title"
          name="title"
          type="text"
          required
          maxlength="200"
          placeholder="e.g. At Last"
          data-testid="song-title"
        />
        <p class="field-error" data-testid="song-title-error" hidden></p>
      </div>

      <div class="field">
        <label for="song-artist">Artist</label>
        <input
          id="song-artist"
          name="artist"
          type="text"
          required
          maxlength="200"
          placeholder="e.g. Etta James"
          data-testid="song-artist"
        />
        <p class="field-error" data-testid="song-artist-error" hidden></p>
      </div>

      <div class="field">
        <label for="song-name">Your name</label>
        <input
          id="song-name"
          name="requested_by"
          type="text"
          required
          maxlength="120"
          placeholder="So we can thank you"
          data-testid="song-name"
        />
        <p class="field-error" data-testid="song-name-error" hidden></p>
      </div>

      <p class="form-error" data-testid="song-form-error" hidden></p>

      <div class="form-actions">
        <button class="btn" type="submit" data-testid="song-submit">Request Song</button>
      </div>
    </form>

    <div class="success-box" data-testid="song-success" hidden>
      <p class="script success-title">thank you!</p>
      <p data-testid="song-success-text">Your song is on the list — the dance floor thanks you.</p>
    </div>

    <Divider />

    <section data-testid="songs-list-section" aria-label="Requests so far">
      <h2 class="section-title section-subtitle">Requests so far</h2>
      <p class="songs-summary" data-testid="songs-count"></p>
      <p class="songs-loading" data-testid="songs-loading">Loading requests…</p>
      <p class="songs-empty" data-testid="songs-empty" hidden>
        Nothing yet — be the first to get this party started!
      </p>
      <ul class="songs-list" data-testid="songs-list" aria-live="polite"></ul>
    </section>
  </section>
</Base>

<script>
  // Dedupe-by-(lowercase title+artist) and sorting live in shared/songs.js,
  // which the server also uses — one implementation, tested by unit tests.
  import { aggregateSongs } from '../../shared/songs.js'

  const form = document.getElementById('song-form') as HTMLFormElement
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-testid="song-submit"]')
  const formError = document.querySelector<HTMLElement>('[data-testid="song-form-error"]')
  const successBox = document.querySelector<HTMLElement>('[data-testid="song-success"]')
  const listEl = document.querySelector<HTMLUListElement>('[data-testid="songs-list"]')
  const countEl = document.querySelector<HTMLElement>('[data-testid="songs-count"]')
  const emptyEl = document.querySelector<HTMLElement>('[data-testid="songs-empty"]')
  const loadingEl = document.querySelector<HTMLElement>('[data-testid="songs-loading"]')

  interface SongRow {
    title: string
    artist: string
    requestedBy?: string
    createdAt?: string
  }

  function setError(field: string, message: string) {
    const el = document.querySelector<HTMLElement>(`[data-testid="song-${field}-error"]`)
    if (!el) return
    el.textContent = message
    el.hidden = !message
    const input = document.getElementById(`song-${field}`)
    if (input) {
      if (message) input.setAttribute('aria-invalid', 'true')
      else input.removeAttribute('aria-invalid')
    }
  }

  function setFormError(message: string) {
    if (!formError) return
    formError.textContent = message
    formError.hidden = !message
  }

  function render(rows: SongRow[]) {
    const aggregated = aggregateSongs(rows)
    if (countEl) {
      const total = rows.length
      const unique = aggregated.length
      countEl.textContent = `${total} request${total === 1 ? '' : 's'} so far · ${unique} song${unique === 1 ? '' : 's'}`
    }
    if (emptyEl) emptyEl.hidden = aggregated.length > 0
    if (!listEl) return
    listEl.innerHTML = ''
    for (const song of aggregated) {
      const li = document.createElement('li')
      li.className = 'song-item'
      li.setAttribute('data-testid', 'song-item')

      const wrap = document.createElement('span')
      wrap.className = 'song-title-artist'

      const title = document.createElement('strong')
      title.setAttribute('data-testid', 'song-title-text')
      title.textContent = song.title

      const artist = document.createElement('span')
      artist.setAttribute('data-testid', 'song-artist-text')
      artist.textContent = ` — ${song.artist}`

      wrap.append(title, artist)

      if (song.requestedBy) {
        const by = document.createElement('span')
        by.className = 'song-by'
        by.textContent = `first requested by ${song.requestedBy}`
        wrap.appendChild(by)
      }

      const count = document.createElement('span')
      count.className = 'song-count'
      count.setAttribute('data-testid', 'song-count')
      count.textContent = `×${song.count}`

      li.append(wrap, count)
      listEl.appendChild(li)
    }
  }

  async function load() {
    try {
      const res = await fetch('/api/songs')
      const data = (await res.json()) as { songs?: SongRow[] }
      render(data.songs ?? [])
    } catch {
      render([])
    } finally {
      if (loadingEl) loadingEl.hidden = true
    }
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    setError('title', '')
    setError('artist', '')
    setError('name', '')
    setFormError('')

    // NB: use elements.namedItem — `form.title`/`form.name` collide with
    // built-in HTMLFormElement properties at runtime.
    const title = (form.elements.namedItem('title') as HTMLInputElement).value
    const artist = (form.elements.namedItem('artist') as HTMLInputElement).value
    const requestedBy = (form.elements.namedItem('requested_by') as HTMLInputElement).value

    let valid = true
    if (!title.trim()) {
      setError('title', 'Please tell us the song title.')
      valid = false
    } else if (title.trim().length > 200) {
      setError('title', 'Title must be 200 characters or fewer.')
      valid = false
    }
    if (!artist.trim()) {
      setError('artist', 'Please tell us the artist.')
      valid = false
    } else if (artist.trim().length > 200) {
      setError('artist', 'Artist must be 200 characters or fewer.')
      valid = false
    }
    if (!requestedBy.trim()) {
      setError('name', 'Please add your name.')
      valid = false
    } else if (requestedBy.trim().length > 120) {
      setError('name', 'Name must be 120 characters or fewer.')
      valid = false
    }
    if (!valid) {
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus()
      return
    }

    if (submitBtn) {
      submitBtn.disabled = true
      submitBtn.textContent = 'Sending…'
    }

    try {
      const res = await fetch('/api/song', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          title: title.trim(),
          artist: artist.trim(),
          requested_by: requestedBy.trim(),
        }),
      })

      if (res.status === 201 || res.ok) {
        form.reset()
        if (successBox) successBox.hidden = false
        await load()
        return
      }

      if (res.status === 422) {
        const data = (await res.json().catch(() => null)) as { errors?: Record<string, string> } | null
        if (data?.errors) {
          if (data.errors.title) setError('title', data.errors.title)
          if (data.errors.artist) setError('artist', data.errors.artist)
          if (data.errors.requested_by) setError('name', data.errors.requested_by)
        }
        setFormError('Please take another look at the highlighted fields.')
        return
      }

      if (res.status === 503) {
        setFormError("Song requests aren't available just yet — please try again soon.")
        return
      }

      setFormError('Something went wrong — please try again in a moment.')
    } catch {
      setFormError("We couldn't reach the server — check your connection and try again.")
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false
        submitBtn.textContent = 'Request Song'
      }
    }
  })

  load()
</script>
