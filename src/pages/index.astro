---
import Base from '../layouts/Base.astro'
import Divider from '../components/Divider.astro'
import PhotoSlot from '../components/PhotoSlot.astro'

// Cards linking to each section (below the fold on the home page).
const sections = [
  { href: '/about', glyph: '❦', title: 'Get to Know Us', blurb: 'Our story, in short', testid: 'home-card-about' },
  { href: '/gallery', glyph: '✧', title: 'Gallery', blurb: 'Moments & memories', testid: 'home-card-gallery' },
  { href: '/wedding-party', glyph: '❦', title: 'Wedding Party', blurb: 'Our favorite people', testid: 'home-card-wedding-party' },
  { href: '/details', glyph: '✧', title: 'Wedding Details', blurb: 'Good to know before you go', testid: 'home-card-details' },
  { href: '/schedule', glyph: '❦', title: 'Schedule', blurb: 'The day, hour by hour', testid: 'home-card-schedule' },
  { href: '/travel', glyph: '✧', title: 'Travel', blurb: 'Getting there & staying', testid: 'home-card-travel' },
  { href: '/registry', glyph: '❦', title: 'Registry', blurb: 'Gifts & goodwill', testid: 'home-card-registry' },
  { href: '/rsvp', glyph: '✧', title: 'RSVP', blurb: 'Say yes — or send regrets', testid: 'home-card-rsvp', rsvp: true },
]
---

<Base title="Home">
  <!-- HERO — recreates the save-the-date: sage photo panel left, cream text panel right. -->
  <section class="hero" data-testid="hero">
    <div class="hero-sage">
      <!--
        ✏️ COUPLE: ENGAGEMENT PHOTO GOES HERE.
        1. Drop a favorite engagement photo into  public/  (e.g. public/hero.jpg)
        2. Replace the <PhotoSlot … /> below with:
             <img src="/hero.jpg" alt="Kendra and Nando" style="width:100%;height:100%;object-fit:cover;" />
      -->
      <PhotoSlot label="engagement photo" ratio="4 / 5" />
      <span class="hero-script" data-testid="hero-script">The Davilas</span>
    </div>

    <div class="hero-cream">
      <div class="hero-card frame" data-testid="hero-card">
        <span class="script">Save the Date</span>
        <h1 class="hero-names" data-testid="hero-names">Kendra <span class="hero-amp">&amp;</span> Nando</h1>
        <p class="hero-date" data-testid="hero-date">October 23, 2027</p>
        <p class="hero-place" data-testid="hero-place">Rockmart, Georgia</p>
        <span class="script script-footer">formal invitation to follow</span>
      </div>
    </div>
  </section>

  <div class="container page">
    <!-- Countdown to the big day -->
    <section class="countdown frame" data-testid="countdown" aria-label="Countdown to the wedding">
      <span class="smallcaps countdown-label" data-testid="countdown-label">Counting down to October 23, 2027</span>
      <div class="count-grid" data-testid="countdown-grid">
        <div class="count-cell">
          <span data-testid="countdown-days">—</span>
          <span class="count-unit">Days</span>
        </div>
        <div class="count-cell">
          <span data-testid="countdown-hours">—</span>
          <span class="count-unit">Hours</span>
        </div>
        <div class="count-cell">
          <span data-testid="countdown-minutes">—</span>
          <span class="count-unit">Minutes</span>
        </div>
        <div class="count-cell">
          <span data-testid="countdown-seconds">—</span>
          <span class="count-unit">Seconds</span>
        </div>
      </div>
    </section>

    <Divider />

    <section class="welcome">
      <p class="script" style="font-size:2.2rem; margin-bottom:.4rem;" data-testid="home-welcome-script">welcome</p>
      <p data-testid="home-welcome-text">
        We can't wait to celebrate with the people we love most. Look around for the schedule, travel
        info, and all the details, and don't forget to RSVP. See you on
        <strong>Saturday, October 23, 2027</strong>.
      </p>
    </section>

    <nav class="cards-grid" aria-label="Site sections" data-testid="home-section-cards">
      {
        sections.map((s) => (
          <a
            class:list={['card', 'frame', { 'card-rsvp': s.rsvp }]}
            href={s.href}
            data-testid={s.testid}
          >
            <span class="card-glyph" aria-hidden="true">
              {s.glyph}
            </span>
            <h2>{s.title}</h2>
            <p>{s.blurb}</p>
          </a>
        ))
      }
    </nav>
  </div>
</Base>

<script>
  // Countdown to cocktail hour: 4:00 PM ET on October 23, 2027 (UTC−4, still EDT).
  const target = new Date('2027-10-23T16:00:00-04:00').getTime()
  const cells = {
    days: document.querySelector('[data-testid="countdown-days"]'),
    hours: document.querySelector('[data-testid="countdown-hours"]'),
    minutes: document.querySelector('[data-testid="countdown-minutes"]'),
    seconds: document.querySelector('[data-testid="countdown-seconds"]'),
  }

  function tick() {
    let diff = Math.max(0, target - Date.now())
    const days = Math.floor(diff / 86_400_000)
    const hours = Math.floor((diff % 86_400_000) / 3_600_000)
    const minutes = Math.floor((diff % 3_600_000) / 60_000)
    const seconds = Math.floor((diff % 60_000) / 1000)

    if (cells.days) cells.days.textContent = String(days).padStart(2, '0')
    if (cells.hours) cells.hours.textContent = String(hours).padStart(2, '0')
    if (cells.minutes) cells.minutes.textContent = String(minutes).padStart(2, '0')
    if (cells.seconds) cells.seconds.textContent = String(seconds).padStart(2, '0')
  }

  tick()
  setInterval(tick, 1000)
</script>
