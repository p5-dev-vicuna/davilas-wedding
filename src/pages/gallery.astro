---
import Base from '../layouts/Base.astro'
import Divider from '../components/Divider.astro'
import PhotoSlot from '../components/PhotoSlot.astro'

// ✏️✏️✏️ COUPLE: GALLERY PHOTOS ✏️✏️✏️
// 1. Drop photos into  public/gallery/  (see public/gallery/README.md).
// 2. For each entry below, set  src: '/gallery/your-file.jpg'  and write a
//    short alt + caption. Leave src: '' to keep a placeholder tile.
// 3. ratio varies per tile so the masonry grid feels organic — tweak freely.
// Filenames map one-to-one with tiles, in order: photos[0] is the first tile.
const photos = [
  { src: '', alt: 'Engagement photo 1', caption: 'The two of us', ratio: '4 / 5', tone: 'sage' },
  { src: '', alt: 'Engagement photo 2', caption: 'The proposal', ratio: '1 / 1', tone: 'gold' },
  { src: '', alt: 'Engagement photo 3', caption: 'Golden hour', ratio: '4 / 3', tone: 'cream' },
  { src: '', alt: 'Engagement photo 4', caption: 'Sunday drives', ratio: '3 / 4', tone: 'gold' },
  { src: '', alt: 'Engagement photo 5', caption: 'Game night', ratio: '1 / 1', tone: 'sage' },
  { src: '', alt: 'Engagement photo 6', caption: 'On the trail', ratio: '4 / 5', tone: 'cream' },
  { src: '', alt: 'Engagement photo 7', caption: 'Coffee dates', ratio: '4 / 3', tone: 'sage' },
  { src: '', alt: 'Engagement photo 8', caption: 'Us, always', ratio: '3 / 4', tone: 'gold' },
]
---

<Base title="Gallery" description="Moments and memories from Kendra & Nando — engagement photos and more.">
  <section class="page">
    <div class="container">
      <header class="page-header">
        <h1 class="section-title" data-testid="gallery-heading">Gallery</h1>
        <Divider />
        <p class="lede" data-testid="gallery-lede">A few of our favorite moments — click any photo to view it larger.</p>
      </header>

      <div class="gallery-grid" data-testid="gallery-grid">
        {
          photos.map((photo, i) => (
            <button
              type="button"
              class="gallery-tile"
              data-testid={`gallery-tile-${i + 1}`}
              data-index={i}
              data-full={photo.src}
              data-caption={photo.caption}
              aria-label={`Open photo: ${photo.caption}`}
            >
              {photo.src ? (
                <img src={photo.src} alt={photo.alt} loading="lazy" />
              ) : (
                <PhotoSlot label={photo.caption} ratio={photo.ratio} tone={photo.tone} />
              )}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Lightbox — vanilla JS, no library (see the script at the bottom). -->
  <div class="lightbox" data-testid="lightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button type="button" class="lightbox-close" data-testid="lightbox-close" aria-label="Close photo viewer">✕</button>
    <button type="button" class="lightbox-nav lightbox-prev" data-testid="lightbox-prev" aria-label="Previous photo">‹</button>
    <figure class="lightbox-figure">
      <div id="lightbox-art" data-testid="lightbox-art"><!-- filled by script --></div>
      <figcaption class="lightbox-caption" data-testid="lightbox-caption"></figcaption>
    </figure>
    <button type="button" class="lightbox-nav lightbox-next" data-testid="lightbox-next" aria-label="Next photo">›</button>
  </div>
</Base>

<script>
  const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-tile'))
  const lightbox = document.querySelector<HTMLElement>('[data-testid="lightbox"]')
  const art = document.getElementById('lightbox-art')
  const caption = document.querySelector<HTMLElement>('[data-testid="lightbox-caption"]')
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-testid="lightbox-close"]')
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-testid="lightbox-prev"]')
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-testid="lightbox-next"]')

  let current = 0
  let lastFocused: HTMLElement | null = null

  function render() {
    const tile = tiles[current]
    if (!tile || !art || !caption) return
    const full = tile.dataset.full ?? ''
    const label = tile.dataset.caption ?? ''
    art.innerHTML = ''
    if (full) {
      const img = document.createElement('img')
      img.src = full
      img.alt = label
      art.appendChild(img)
    } else {
      // Placeholder enlarged — mirrors the tile's look until real photos land.
      const slot = document.createElement('figure')
      slot.className = 'photo-slot'
      slot.style.aspectRatio = '4 / 3'
      const glyph = document.createElement('span')
      glyph.className = 'photo-glyph'
      glyph.setAttribute('aria-hidden', 'true')
      glyph.textContent = '❦'
      const cap = document.createElement('figcaption')
      cap.className = 'photo-label'
      cap.textContent = label
      slot.append(glyph, cap)
      art.appendChild(slot)
    }
    caption.textContent = label
  }

  function open(index: number) {
    current = index
    render()
    lastFocused = document.activeElement as HTMLElement | null
    lightbox?.removeAttribute('hidden')
    closeBtn?.focus()
  }

  function close() {
    lightbox?.setAttribute('hidden', '')
    lastFocused?.focus()
  }

  function step(delta: number) {
    if (tiles.length === 0) return
    current = (current + delta + tiles.length) % tiles.length
    render()
  }

  document.querySelector('.gallery-grid')?.addEventListener('click', (event) => {
    const tile = (event.target as HTMLElement).closest<HTMLButtonElement>('.gallery-tile')
    if (tile) open(Number(tile.dataset.index ?? 0))
  })

  closeBtn?.addEventListener('click', close)
  prevBtn?.addEventListener('click', () => step(-1))
  nextBtn?.addEventListener('click', () => step(1))

  // Backdrop click closes (clicks inside the figure/controls are ignored).
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) close()
  })

  document.addEventListener('keydown', (event) => {
    if (!lightbox || lightbox.hidden) return
    if (event.key === 'Escape') close()
    if (event.key === 'ArrowLeft') step(-1)
    if (event.key === 'ArrowRight') step(1)
  })
</script>
