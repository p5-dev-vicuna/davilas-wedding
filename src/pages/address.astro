---
import Base from '../layouts/Base.astro'
import Divider from '../components/Divider.astro'
---

<Base
  title="Mailing Address"
  description="Beat the RSVP rush — give Kendra & Nando your current mailing address so your invitation finds you."
>
  <section class="page page-narrow">
    <header class="page-header">
      <p class="script script-accent" data-testid="address-accent">Don't lose us in the mail</p>
      <h1 class="section-title" data-testid="address-heading">Where should we send your invitation?</h1>
      <Divider />
      <p class="lede" data-testid="address-lede">
        Beat the RSVP rush — give us your current mailing address now, so your invitation finds you
        wherever you land.
      </p>
    </header>

    <form id="address-form" class="form" novalidate data-testid="address-form">
      <div class="field">
        <label for="address-name">Full name(s)</label>
        <p class="field-hint" id="address-name-hint">For the envelope — e.g. 'Fernanda &amp; Alex Davila'</p>
        <input
          id="address-name"
          name="full_name"
          type="text"
          autocomplete="name"
          aria-describedby="address-name-hint"
          required
          maxlength="120"
          placeholder="Names as they should appear on the envelope"
          data-testid="address-name"
        />
        <p class="field-error" data-testid="address-name-error" hidden></p>
      </div>

      <div class="field">
        <label for="address-street">Street address</label>
        <input
          id="address-street"
          name="street"
          type="text"
          autocomplete="address-line1"
          required
          maxlength="200"
          placeholder="123 Wedding Way"
          data-testid="address-street"
        />
        <p class="field-error" data-testid="address-street-error" hidden></p>
      </div>

      <div class="field">
        <label for="address-unit">Apt / unit <span class="optional">(optional)</span></label>
        <input
          id="address-unit"
          name="unit"
          type="text"
          autocomplete="address-line2"
          maxlength="30"
          placeholder="Apt 4B"
          data-testid="address-unit"
        />
        <p class="field-error" data-testid="address-unit-error" hidden></p>
      </div>

      <div class="address-city-row">
        <div class="field">
          <label for="address-city">City</label>
          <input
            id="address-city"
            name="city"
            type="text"
            autocomplete="address-level2"
            required
            maxlength="100"
            placeholder="Rockmart"
            data-testid="address-city"
          />
          <p class="field-error" data-testid="address-city-error" hidden></p>
        </div>

        <div class="field">
          <label for="address-state">State</label>
          <input
            id="address-state"
            name="state"
            type="text"
            autocomplete="address-level1"
            required
            maxlength="50"
            placeholder="GA"
            data-testid="address-state"
          />
          <p class="field-error" data-testid="address-state-error" hidden></p>
        </div>

        <div class="field">
          <label for="address-zip">ZIP / postal code</label>
          <input
            id="address-zip"
            name="postal_code"
            type="text"
            autocomplete="postal-code"
            required
            maxlength="20"
            placeholder="30153"
            data-testid="address-zip"
          />
          <p class="field-error" data-testid="address-zip-error" hidden></p>
        </div>
      </div>

      <div class="field">
        <label for="address-country">Country <span class="optional">(optional — we'll assume USA)</span></label>
        <input
          id="address-country"
          name="country"
          type="text"
          autocomplete="country-name"
          maxlength="100"
          value="USA"
          data-testid="address-country"
        />
        <p class="field-error" data-testid="address-country-error" hidden></p>
      </div>

      <div class="field">
        <label for="address-notes">Anything we should know? <span class="optional">(optional)</span></label>
        <textarea
          id="address-notes"
          name="notes"
          rows="3"
          maxlength="500"
          placeholder="e.g. we're moving in June"
          data-testid="address-notes"></textarea>
        <p class="field-error" data-testid="address-notes-error" hidden></p>
      </div>

      <p class="form-error" data-testid="address-form-error" hidden></p>

      <div class="form-actions">
        <button class="btn" type="submit" data-testid="address-submit">Send Address</button>
      </div>
    </form>

    <div class="success-box" data-testid="address-success" hidden>
      <p class="script success-title">coming your way!</p>
      <p data-testid="address-success-text">Sealed and delivered — you're on the list. 💌</p>
    </div>

    <Divider />

    <p class="center" data-testid="address-rsvp-teaser">
      Already know you're coming?
      <a href="/rsvp" data-testid="address-rsvp-link">RSVP here →</a>
    </p>
  </section>
</Base>

<script>
  const form = document.getElementById('address-form') as HTMLFormElement
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-testid="address-submit"]')
  const formError = document.querySelector<HTMLElement>('[data-testid="address-form-error"]')
  const successBox = document.querySelector<HTMLElement>('[data-testid="address-success"]')
  const successText = document.querySelector<HTMLElement>('[data-testid="address-success-text"]')

  // Personal link token (?g=<token>) — silent by design: nothing renders it,
  // it just rides along with the submission so the couple can cross-reference
  // guest_tokens.csv. Absent token is fine — the form works either way.
  const guestToken =
    new URLSearchParams(window.location.search)
      .get('g')
      ?.trim()
      .slice(0, 64) ?? ''

  // server field name -> testid infix used on this page
  const errorMap: Record<string, string> = {
    full_name: 'name',
    street: 'street',
    unit: 'unit',
    city: 'city',
    state: 'state',
    postal_code: 'zip',
    country: 'country',
    notes: 'notes',
  }

  function fieldErrorEl(field: string): HTMLElement | null {
    const infix = errorMap[field] ?? field
    return document.querySelector<HTMLElement>(`[data-testid="address-${infix}-error"]`)
  }

  function setError(field: string, message: string) {
    const el = fieldErrorEl(field)
    if (!el) return
    el.textContent = message
    el.hidden = !message
    const input = document.getElementById(`address-${errorMap[field] ?? field}`)
    if (input) {
      if (message) input.setAttribute('aria-invalid', 'true')
      else input.removeAttribute('aria-invalid')
    }
  }

  function clearErrors() {
    for (const field of Object.keys(errorMap)) setError(field, '')
    if (formError) {
      formError.textContent = ''
      formError.hidden = true
    }
  }

  function setFormError(message: string) {
    if (!formError) return
    formError.textContent = message
    formError.hidden = !message
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    clearErrors()

    const fullName = (form.elements.namedItem('full_name') as HTMLInputElement).value
    const street = (form.elements.namedItem('street') as HTMLInputElement).value
    const unit = (form.elements.namedItem('unit') as HTMLInputElement).value
    const city = (form.elements.namedItem('city') as HTMLInputElement).value
    const state = (form.elements.namedItem('state') as HTMLInputElement).value
    const zip = (form.elements.namedItem('postal_code') as HTMLInputElement).value
    const country = (form.elements.namedItem('country') as HTMLInputElement).value
    const notes = (form.elements.namedItem('notes') as HTMLTextAreaElement).value

    let valid = true
    if (!fullName.trim()) {
      setError('full_name', 'Please add the name(s) for your envelope.')
      valid = false
    } else if (fullName.trim().length > 120) {
      setError('full_name', 'Name must be 120 characters or fewer.')
      valid = false
    }
    if (!street.trim()) {
      setError('street', 'Please add your street address.')
      valid = false
    } else if (street.trim().length > 200) {
      setError('street', 'Street address must be 200 characters or fewer.')
      valid = false
    }
    if (unit.trim().length > 30) {
      setError('unit', 'Apt / unit must be 30 characters or fewer.')
      valid = false
    }
    if (!city.trim()) {
      setError('city', 'Please add your city.')
      valid = false
    } else if (city.trim().length > 100) {
      setError('city', 'City must be 100 characters or fewer.')
      valid = false
    }
    if (!state.trim()) {
      setError('state', 'Please add your state.')
      valid = false
    } else if (state.trim().length > 50) {
      setError('state', 'State must be 50 characters or fewer.')
      valid = false
    }
    if (!zip.trim()) {
      setError('postal_code', 'Please add your ZIP / postal code.')
      valid = false
    } else if (zip.trim().length > 20) {
      setError('postal_code', 'ZIP / postal code must be 20 characters or fewer.')
      valid = false
    }
    if (country.trim().length > 100) {
      setError('country', 'Country must be 100 characters or fewer.')
      valid = false
    }
    if (notes.trim().length > 500) {
      setError('notes', 'Please keep this under 500 characters.')
      valid = false
    }

    if (!valid) {
      // First invalid field gets focus so the fix is one thumb away.
      const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]')
      firstInvalid?.focus()
      return
    }

    if (submitBtn) {
      submitBtn.disabled = true
      submitBtn.textContent = 'Sending…'
    }

    try {
      const res = await fetch('/api/address', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          full_name: fullName.trim(),
          street: street.trim(),
          unit: unit.trim(),
          city: city.trim(),
          state: state.trim(),
          postal_code: zip.trim(),
          country: country.trim(),
          notes: notes.trim(),
          guest_token: guestToken || null,
        }),
      })

      if (res.status === 201 || res.ok) {
        const data = (await res.json().catch(() => null)) as { message?: string } | null
        if (successText) {
          successText.textContent =
            data?.message ?? "Sealed and delivered — you're on the list. 💌"
        }
        form.hidden = true
        if (successBox) successBox.hidden = false
        successBox?.scrollIntoView({ behavior: 'smooth', block: 'center' })
        return
      }

      if (res.status === 422) {
        const data = (await res.json().catch(() => null)) as { errors?: Record<string, string> } | null
        if (data?.errors) {
          for (const [field, message] of Object.entries(data.errors)) {
            if (errorMap[field]) setError(field, message)
          }
        }
        setFormError('Please take another look at the highlighted fields.')
        const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]')
        firstInvalid?.focus()
        return
      }

      if (res.status === 503) {
        setFormError("Submissions aren't available just yet — please try again soon.")
        return
      }

      setFormError('Something went wrong — please try again in a moment.')
    } catch {
      setFormError("We couldn't reach the server — check your connection and try again.")
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false
        submitBtn.textContent = 'Send Address'
      }
    }
  })
</script>
