---
import Base from '../layouts/Base.astro'
import Divider from '../components/Divider.astro'

// ✏️✏️✏️ COUPLE: REGISTRY LINKS ✏️✏️✏️
// Replace each href="#" below with the real registry / fund URL, e.g.:
//   Amazon  → https://www.amazon.com/wedding/registry/XXXX
//   Target  → https://www.target.com/gift-registry/XXXX
//   Honeymoon → your fund link (Zola, Honeyfund, etc.)
// The cards stay hidden-behind-"#" until you paste real links.
const registries = [
  {
    store: 'Amazon',
    glyph: '❦',
    note: 'Practical bits and pieces for home.',
    href: '#',
    testid: 'amazon',
  },
  {
    store: 'Target',
    glyph: '✧',
    note: 'A few favorites for the new chapter.',
    href: '#',
    testid: 'target',
  },
  {
    store: 'Honeymoon Fund',
    glyph: '❦',
    note: 'Help send us off on our first adventure.',
    href: '#',
    testid: 'honeymoon',
  },
]
---

<Base title="Registry" description="Registry and honeymoon fund for Kendra & Nando — The Davilas.">
  <section class="page page-narrow">
    <header class="page-header">
      <h1 class="section-title" data-testid="registry-heading">Registry</h1>
      <Divider />
    </header>

    <section class="welcome" data-testid="registry-intro">
      <p class="script" style="font-size:2rem;">your presence is the gift</p>
      <p>
        Truly — having you with us on October 23, 2027 is the greatest gift of all. If you'd still like
        to celebrate with something wrapped in a bow, we've registered at a few of our favorite places
        below.
      </p>
    </section>

    <!-- ✏️ For each card below, replace href="#" with the real registry URL (see the
         `registries` array at the top of this file's frontmatter). -->
    <div class="registry-grid" data-testid="registry-grid">
      {
        registries.map((r) => (
          <article class="registry-card frame" data-testid={`registry-card-${r.testid}`}>
            <span class="registry-glyph" aria-hidden="true">
              {r.glyph}
            </span>
            <h2 class="registry-store">{r.store}</h2>
            <p class="registry-note">{r.note}</p>
            <a class="btn btn-outline" href={r.href} target="_blank" rel="noopener noreferrer" data-testid={`registry-link-${r.testid}`}>
              Visit Registry
            </a>
          </article>
        ))
      }
    </div>

    <p class="center" style="margin-top:2.4rem;" data-testid="registry-footer-note">
      Links coming soon — check back as the big day draws near.
    </p>
  </section>
</Base>
