---
// Shared layout: header (script monogram + nav + RSVP button), footer, fonts.
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const {
  title,
  description = 'Kendra & Nando are getting married! Join The Davilas on Saturday, October 23, 2027 at 1513 at Stone Creek in Rockmart, Georgia.',
} = Astro.props

// Nav tabs — exact order per the brief. RSVP is deliberately NOT here;
// it lives as the standout header button on every page.
const navItems = [
  { href: '/', label: 'Home', testid: 'nav-home' },
  { href: '/about', label: 'Get to Know Us', testid: 'nav-about' },
  { href: '/gallery', label: 'Gallery', testid: 'nav-gallery' },
  { href: '/wedding-party', label: 'Wedding Party', testid: 'nav-wedding-party' },
  { href: '/details', label: 'Wedding Details', testid: 'nav-details' },
  { href: '/schedule', label: 'Schedule', testid: 'nav-schedule' },
  { href: '/travel', label: 'Travel', testid: 'nav-travel' },
  { href: '/registry', label: 'Registry', testid: 'nav-registry' },
]

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f5f1e8" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · The Davilas</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Great+Vibes&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" data-testid="site-header">
      <div class="header-inner">
        <a class="monogram" href="/" data-testid="monogram">The Davilas</a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          data-testid="nav-toggle"
        >
          <span class="visually-hidden">Toggle navigation</span>
          <span class="nav-toggle-icon" aria-hidden="true">☰</span>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Main navigation" data-testid="site-nav">
          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    data-testid={item.testid}
                    aria-current={currentPath === item.href ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <!-- RSVP: the standout header button, opposite the nav, on every page. -->
        <a class="btn header-rsvp" href="/rsvp" data-testid="header-rsvp">RSVP</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer" data-testid="site-footer">
      <p class="footer-names script">Kendra &amp; Nando</p>
      <p class="footer-line" data-testid="footer-event-line">
        Saturday, October 23, 2027 · 1513 at Stone Creek · Rockmart, Georgia
      </p>
      <div class="divider divider-light" aria-hidden="true">
        <span class="divider-rule"></span>
        <span class="divider-glyph">❦</span>
        <span class="divider-rule"></span>
      </div>
      <nav class="footer-links" aria-label="Footer" data-testid="footer-nav">
        <a href="/songs" data-testid="footer-songs-link">Song Requests</a>
        <span aria-hidden="true">·</span>
        <a href="/faq" data-testid="footer-faq-link">FAQ</a>
      </nav>
      <p class="footer-contact">Questions? Reach out to Kendra &amp; Nando — we can't wait to celebrate with you.</p>
      <p class="fineprint" aria-hidden="true">❦ with love, from the soon-to-be Davilas ❦</p>
    </footer>

    <script>
      const header = document.querySelector('.site-header')
      const toggle = document.querySelector('.nav-toggle')

      toggle?.addEventListener('click', () => {
        const open = header.classList.toggle('open')
        toggle.setAttribute('aria-expanded', String(open))
        const icon = toggle.querySelector('.nav-toggle-icon')
        if (icon) icon.textContent = open ? '✕' : '☰'
      })

      // Close the mobile menu after choosing a destination.
      document.querySelectorAll('.site-nav a').forEach((link) =>
        link.addEventListener('click', () => {
          header.classList.remove('open')
          toggle?.setAttribute('aria-expanded', 'false')
          const icon = toggle?.querySelector('.nav-toggle-icon')
          if (icon) icon.textContent = '☰'
        })
      )

      // Escape closes the mobile menu and hands focus back to the toggle.
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !header.classList.contains('open')) return
        header.classList.remove('open')
        toggle?.setAttribute('aria-expanded', 'false')
        const icon = toggle?.querySelector('.nav-toggle-icon')
        if (icon) icon.textContent = '☰'
        toggle?.focus()
      })
    </script>
  </body>
</html>
