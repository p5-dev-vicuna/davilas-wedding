# Copy this file to `.env` and fill in real values.
# The Bun server reads these at startup (server/index.js loads .env if present;
# Bun auto-loads it too — real environment variables always win).

# Neon Postgres connection string — required for RSVP + song + address
# submissions. Until this is set, POST /api/rsvp, POST /api/song, and
# POST /api/address return 503 (by design, so the site can deploy before
# database credentials exist).
# Get it from your Neon project dashboard (Connection string / pooled).
DATABASE_URL=postgresql://user:password@ep-example-123.us-east-2.aws.neon.tech/neondb?sslmode=require

# Bearer token required for the admin endpoints:
#   GET /api/rsvps         (JSON export)
#   GET /api/rsvps.csv     (spreadsheet export)
#   GET /api/addresses     (JSON export, matched/unmatched)
#   GET /api/addresses.csv (spreadsheet export)
# Use a long random string. Requests must send:  Authorization: Bearer <ADMIN_KEY>
ADMIN_KEY=change-me-to-a-long-random-string

# Public base URL of the site — only scripts/import_guests.mjs reads it, to
# build the personal /address?g=<token> links in guest_tokens.csv.
# SITE_URL=https://your-host

# Optional: port for the local server (default 3000; Coolify sets PORT itself)
# PORT=3000
