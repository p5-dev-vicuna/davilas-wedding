{
  "name": "davilas-wedding",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Wedding website for Kendra & Nando — The Davilas. October 23, 2027 · 1513 at Stone Creek · Rockmart, GA. Bun-native stack: no Astro, no Hono, no Vitest, no runtime dependencies.",
  "scripts": {
    "dev": "BUN_DEV=1 bun server/index.js",
    "build": "bun scripts/build.mjs",
    "start": "cd dist && bun index.js",
    "typecheck": "bun check",
    "lint": "bun lint --no-script",
    "fmt": "bun fmt --no-script",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:e2e": "bun scripts/run-e2e.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "bun-types": "^1.4.4"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
